# BuildKit Dockerfile-specific ignore file (context = repository root).
# Allowlist: only the backend sources, and the frontend for the export viewer stage, reach the build context.
**
!backend/
!frontend/
frontend/node_modules/
frontend/dist/
frontend/dist-export/
frontend/test-results/
frontend/.env*
backend/.venv/
backend/indexers/node_modules/
backend/**/__pycache__/
backend/tests/
backend/.env*
backend/**/*.pem
