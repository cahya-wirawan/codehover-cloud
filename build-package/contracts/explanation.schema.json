{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "codehover-cloud Explanation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "symbols",
    "notes"
  ],
  "properties": {
    "summary": {
      "type": "string",
      "maxLength": 2000
    },
    "symbols": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "symbol_key",
          "summary",
          "details",
          "params",
          "returns",
          "notes"
        ],
        "properties": {
          "symbol_key": {
            "type": "string",
            "maxLength": 500
          },
          "summary": {
            "type": "string",
            "maxLength": 600
          },
          "details": {
            "type": "string",
            "maxLength": 3000
          },
          "params": {
            "type": "object",
            "maxProperties": 100,
            "additionalProperties": {
              "type": "string",
              "maxLength": 600
            }
          },
          "returns": {
            "type": "string",
            "maxLength": 1000
          },
          "notes": {
            "type": "string",
            "maxLength": 1000
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "start_line",
          "end_line",
          "text"
        ],
        "properties": {
          "start_line": {
            "type": "integer",
            "minimum": 1
          },
          "end_line": {
            "type": "integer",
            "minimum": 1
          },
          "text": {
            "type": "string",
            "maxLength": 1000
          }
        }
      }
    }
  }
}
