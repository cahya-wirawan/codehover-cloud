{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codehover-cloud:schema:overview:1.0.0",
  "title": "codehover-cloud repository overview v1 (19 P03)",
  "type": "object",
  "additionalProperties": false,
  "required": ["overview", "key_concepts", "reading_order"],
  "properties": {
    "overview": {"type": "string", "maxLength": 3000},
    "key_concepts": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["term", "explanation"],
        "properties": {
          "term": {"type": "string", "maxLength": 120},
          "explanation": {"type": "string", "maxLength": 1000}
        }
      }
    },
    "reading_order": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file_id", "reason"],
        "properties": {
          "file_id": {"type": "string", "maxLength": 36},
          "reason": {"type": "string", "maxLength": 500}
        }
      }
    }
  }
}
