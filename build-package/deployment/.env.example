# Development-only examples; replace every placeholder before start.
# URL-encode URI passwords; local example values below intentionally URL-safe.
POSTGRES_PASSWORD=replace-with-local-ddl-secret
APP_DB_PASSWORD=replace-with-local-runtime-secret
APP_SYSTEM_DB_PASSWORD=replace-with-local-system-loop-secret
RABBITMQ_USER=codehover
RABBITMQ_PASSWORD=replace-with-local-broker-secret
S3_ROOT_USER=codehoverlocal
S3_ROOT_PASSWORD=replace-with-local-storage-secret
PUBLIC_ORIGIN=http://localhost:8080
SESSION_COOKIE_SECURE=false
SESSION_SECRET=replace-with-at-least-32-random-bytes
# Data-encryption key for PKCE verifiers, encrypted webhook payloads and (P1) BYOK secrets.
# Distinct from SESSION_SECRET; production uses a KMS/secret-manager key reference instead.
APP_ENCRYPTION_KEY=replace-with-32-random-bytes-base64
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# The GitHub App's own client credentials: used once per install to obtain a short-lived
# user access token and verify the installation via GET /user/installations (see 09).
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Must exist for the app profile; with replay/fake adapters a placeholder file is enough.
GITHUB_APP_PRIVATE_KEY_HOST_PATH=./secrets/github-app.pem
GITHUB_WEBHOOK_SECRET=
MODEL_PROVIDER=replay
MODEL_ID=replay-v1
MODEL_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Example image references only, verified/pinned by implementation CI before use.
POSTGRES_IMAGE=postgres:18
RABBITMQ_IMAGE=rabbitmq:4-management
# MinIO community images stopped being published in Oct 2025 and the project was archived in 2026;
# this old tag receives no fixes. Choose a maintained S3-compatible image before relying on it
# (see 22 "Local object store"); any replacement must accept the same S3_* settings.
OBJECT_STORE_IMAGE=quay.io/minio/minio:RELEASE.2025-04-22T22-12-26Z
