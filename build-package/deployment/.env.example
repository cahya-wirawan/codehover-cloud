# Development-only examples; replace every placeholder before start.
# URL-encode URI passwords; local example values below intentionally URL-safe.
POSTGRES_PASSWORD=replace-with-local-ddl-secret
APP_DB_PASSWORD=replace-with-local-runtime-secret
RABBITMQ_USER=codehover
RABBITMQ_PASSWORD=replace-with-local-broker-secret
S3_ROOT_USER=codehoverlocal
S3_ROOT_PASSWORD=replace-with-local-storage-secret
PUBLIC_ORIGIN=http://localhost:8080
SESSION_COOKIE_SECURE=false
SESSION_SECRET=replace-with-at-least-32-random-bytes
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY_HOST_PATH=./secrets/github-app.pem
GITHUB_WEBHOOK_SECRET=
MODEL_PROVIDER=replay
MODEL_ID=replay-v1
MODEL_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Example image references only, verified/pinned by implementation CI before use.
POSTGRES_IMAGE=postgres:18
RABBITMQ_IMAGE=rabbitmq:4-management
OBJECT_STORE_IMAGE=quay.io/minio/minio:RELEASE.2025-04-22T22-12-26Z
