{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codehover-cloud:schema:explanation:2.0.0",
  "title": "codehover-cloud Explanation v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "symbols",
    "notes"
  ],
  "properties": {
    "summary": {
      "type": "string",
      "maxLength": 2000
    },
    "symbols": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "symbol_key",
          "summary",
          "details",
          "params",
          "returns",
          "notes"
        ],
        "properties": {
          "symbol_key": {
            "type": "string",
            "maxLength": 500
          },
          "summary": {
            "type": "string",
            "maxLength": 600
          },
          "details": {
            "type": "string",
            "maxLength": 3000
          },
          "params": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "description"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "maxLength": 200,
                  "description": "Exact parameter identifier from source; never translated"
                },
                "description": {
                  "type": "string",
                  "maxLength": 600
                }
              }
            }
          },
          "returns": {
            "type": "string",
            "maxLength": 1000
          },
          "notes": {
            "type": "string",
            "maxLength": 1000
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "start_line",
          "end_line",
          "text"
        ],
        "properties": {
          "start_line": {
            "type": "integer",
            "minimum": 1
          },
          "end_line": {
            "type": "integer",
            "minimum": 1
          },
          "text": {
            "type": "string",
            "maxLength": 1000
          }
        }
      }
    }
  },
  "$comment": "Length/count keywords are enforced by the local semantic validator; strict provider structured-output modes may reject or strip maxLength/maxItems/minimum, so the gateway sends a provider-compatible projection. Every object is closed (additionalProperties:false) and maps are arrays, as strict modes require."
}
